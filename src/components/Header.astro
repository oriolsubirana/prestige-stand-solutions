---
import Icon from "./Icon.astro";
import LangToggle from "./LangToggle.astro";
import { localePath, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang);
const links = (["services", "sectors", "projects", "process"] as const).map((key) => ({
  href: `${home}#${t.ids[key]}`,
  label: t.nav[key],
}));
const ctaHref = `${home}#${t.ids.contact}`;
---

<header class="sticky top-0 z-10 bg-[color-mix(in_srgb,var(--color-bg)_88%,transparent)] backdrop-blur-[10px]">
  <nav aria-label={t.a11y.mainNav} class="mx-auto flex max-w-[1240px] items-center gap-3 px-5 py-4">
    <a href={`${home}#top`} class="mr-auto flex flex-col gap-0.5 leading-none no-underline" aria-label={t.a11y.home}>
      <span class="text-[22px] font-semibold tracking-[-0.02em] text-[var(--color-accent)]">Prestige Stand</span>
      <span class="flex items-center gap-1.5 text-[8px] tracking-[0.42em] text-[var(--color-accent-400)]">
        SOLUTIONS<span class="h-px min-w-10 flex-1 bg-[var(--color-accent-600)]"></span>
      </span>
    </a>

    <ul class="hidden items-center gap-[22px] lg:flex">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} class="text-sm text-[var(--color-text)] no-underline hover:text-[var(--color-accent)]">
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <a href={ctaHref} class="btn btn-primary hidden sm:inline-flex lg:ml-3">
      {t.nav.cta} <Icon name="arrow-right" />
    </a>

    <LangToggle lang={lang} path={path} />

    <button
      type="button"
      class="btn btn-secondary size-11 p-0 lg:hidden"
      aria-controls="mobile-nav"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="sr-only">{t.a11y.menu}</span>
      <span data-icon-open><Icon name="list" class="text-xl" /></span>
      <span data-icon-close hidden><Icon name="x" class="text-xl" /></span>
    </button>
  </nav>

  <nav id="mobile-nav" aria-label={t.a11y.mainNav} hidden class="lg:hidden">
    <ul class="mx-auto flex max-w-[1240px] flex-col px-5 pb-4">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} class="block py-3 text-base text-[var(--color-text)] no-underline" data-menu-link>
              {label}
            </a>
          </li>
        ))
      }
      <li class="pt-2 sm:hidden">
        <a href={ctaHref} class="btn btn-primary btn-lg w-full" data-menu-link>
          {t.nav.cta} <Icon name="arrow-right" />
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.getElementById("mobile-nav");

  const setOpen = (open: boolean) => {
    toggle?.setAttribute("aria-expanded", String(open));
    if (panel) panel.hidden = !open;
    toggle?.querySelector<HTMLElement>("[data-icon-open]")?.toggleAttribute("hidden", open);
    toggle?.querySelector<HTMLElement>("[data-icon-close]")?.toggleAttribute("hidden", !open);
  };

  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  panel?.querySelectorAll("[data-menu-link]").forEach((link) => link.addEventListener("click", () => setOpen(false)));
</script>
