---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLang, languages, localePath, useTranslations, type Lang } from "../i18n";

export interface Props {
  title: string;
  description?: string;
  /** Path of this page without the locale prefix, used for alternates and the language toggle */
  path?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { title, description = t.meta.description, path = "/" } = Astro.props;
const canonical = new URL(localePath(lang, path), Astro.site);
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(localePath(l, path), Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#292f36" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_GB"} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh flex-col overflow-x-hidden font-sans">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-[var(--color-surface)] focus:px-4 focus:py-2"
      >{t.a11y.skip}</a
    >
    <Header lang={lang} path={path} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
