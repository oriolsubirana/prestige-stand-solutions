---
import { localePath, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang);
---

<footer class="mx-auto w-full max-w-[1240px] px-5 pb-10">
  <div class="rule-fade mb-7"></div>
  <div class="flex flex-wrap justify-between gap-5 text-[13px] text-[var(--color-neutral-400)]">
    <span>{t.footer.tagline}</span>
    <div class="flex gap-[18px]">
      <a href={`${home}#${t.ids.services}`}>{t.nav.services}</a>
      <a href={`${home}#${t.ids.projects}`}>{t.nav.projects}</a>
      <a href={`${home}#${t.ids.contact}`}>{t.footer.contact}</a>
    </div>
  </div>
</footer>
