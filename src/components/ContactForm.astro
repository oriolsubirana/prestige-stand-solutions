---
import Icon from "./Icon.astro";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).form;

const fields = [
  { name: "name", label: t.name, type: "text", autocomplete: "name", required: true },
  { name: "email", label: t.email, type: "email", autocomplete: "email", required: true },
  { name: "company", label: t.company, type: "text", autocomplete: "organization" },
  { name: "phone", label: t.phone, type: "tel", autocomplete: "tel" },
  { name: "exhibition", label: t.exhibition, type: "text", autocomplete: "off", placeholder: t.exhibitionPlaceholder },
  { name: "size", label: t.size, type: "number", autocomplete: "off" },
] as const;

const needs = (["stand", "grafica", "ambos"] as const).map((value) => ({ value, label: t.needs[value] }));
---

<div class="card elev-md p-7" data-contact>
  <form
    action="/actions/send-email"
    method="post"
    class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-3.5"
    data-contact-form
  >
    <input type="hidden" name="lang" value={lang} />
    <p data-contact-error role="alert" hidden class="col-span-full rounded-[var(--radius-md)] bg-[#5a2a2a] px-3 py-2 text-sm text-[#f6d6d6]">
      {t.error}
    </p>

    {
      fields.map((f) => (
        <div class="field">
          <label for={`cf-${f.name}`}>
            {f.label}
            {"required" in f && f.required && <span aria-hidden="true"> *</span>}
          </label>
          <input
            id={`cf-${f.name}`}
            class="input"
            name={f.name}
            type={f.type}
            autocomplete={f.autocomplete}
            required={"required" in f ? f.required : undefined}
            placeholder={"placeholder" in f ? f.placeholder : undefined}
            min={f.type === "number" ? 1 : undefined}
          />
        </div>
      ))
    }

    <fieldset class="field col-span-full m-0 border-0 p-0">
      <legend class="field-label mb-[5px] p-0 text-xs text-[color-mix(in_srgb,var(--color-text)_70%,transparent)]">{t.need}</legend>
      <div class="seg">
        {
          needs.map((n) => (
            <label class="seg-opt">
              <input type="radio" name="need" value={n.value} checked={n.value === "ambos"} />
              {n.label}
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="field col-span-full">
      <label for="cf-message">{t.message}</label>
      <textarea id="cf-message" class="input" name="message" placeholder={t.messagePlaceholder}></textarea>
    </div>

    <div class="col-span-full flex justify-end">
      <button type="submit" class="btn btn-primary btn-lg" data-contact-submit>
        {t.submit} <Icon name="paper-plane-tilt" />
      </button>
    </div>
  </form>

  <div data-contact-sent hidden class="flex flex-col items-start gap-2.5 py-10" tabindex="-1">
    <Icon name="check-circle" class="text-4xl text-[var(--color-accent)]" />
    <h3>{t.sentTitle}</h3>
    <p class="m-0 text-[var(--color-neutral-400)]">{t.sentText}</p>
    <button type="button" class="btn btn-secondary" data-contact-reset>{t.again}</button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-contact]");
  const form = root?.querySelector<HTMLFormElement>("[data-contact-form]");
  const sent = root?.querySelector<HTMLElement>("[data-contact-sent]");
  const error = root?.querySelector<HTMLElement>("[data-contact-error]");
  const submit = root?.querySelector<HTMLButtonElement>("[data-contact-submit]");

  if (new URLSearchParams(location.search).get("status") === "error" && error) error.hidden = false;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (error) error.hidden = true;
    if (submit) submit.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      form.reset();
      form.hidden = true;
      if (sent) {
        sent.hidden = false;
        sent.focus();
      }
    } catch {
      if (error) error.hidden = false;
    } finally {
      if (submit) submit.disabled = false;
    }
  });

  root?.querySelector("[data-contact-reset]")?.addEventListener("click", () => {
    if (sent) sent.hidden = true;
    if (form) {
      form.hidden = false;
      form.querySelector<HTMLInputElement>("input")?.focus();
    }
  });
</script>
